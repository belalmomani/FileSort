<Window x:Class="FileSort.Desktop.LibraryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Lib_Title}" Width="1100" Height="640" MinWidth="800" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgBrush}" Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI" FontSize="13">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- filters -->
        <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}" Padding="12,10"
                BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid>
                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="{DynamicResource Lib_Search}" IsHitTestVisible="False" Margin="9,0"
                                   Foreground="{DynamicResource SubTextBrush}" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SearchText}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0">
                        <Button Style="{StaticResource SecondaryButton}" Content="{DynamicResource Lib_Verify}" Command="{Binding VerifyCommand}"/>
                        <Button Style="{StaticResource SecondaryButton}" Margin="6,0,0,0" Content="{DynamicResource Lib_Refresh}" Command="{Binding ReloadCommand}"/>
                    </StackPanel>
                </Grid>

                <ItemsControl ItemsSource="{Binding Categories}" Margin="0,8,0,0">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ToggleButton Style="{StaticResource PillToggle}" Margin="2,2"
                                          IsChecked="{Binding IsSelected, Mode=OneWay}" CommandParameter="{Binding}"
                                          Command="{Binding DataContext.FilterCategoryCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="10" Height="10" Fill="{Binding Brush}" Margin="0,0,6,0"/>
                                    <TextBlock Text="{Binding Name}"/>
                                </StackPanel>
                            </ToggleButton>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <WrapPanel Margin="0,4,0,0">
                    <ItemsControl ItemsSource="{Binding Priorities}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <ToggleButton Style="{StaticResource PillToggle}" Margin="2,2"
                                              IsChecked="{Binding IsSelected, Mode=OneWay}" CommandParameter="{Binding}"
                                              Command="{Binding DataContext.FilterPriorityCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                                    <StackPanel Orientation="Horizontal">
                                        <Rectangle Width="10" Height="10" RadiusX="2" RadiusY="2" Fill="{Binding Brush}" Margin="0,0,6,0"/>
                                        <TextBlock Text="{Binding Name}"/>
                                    </StackPanel>
                                </ToggleButton>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ToggleButton Style="{StaticResource PillToggle}" Margin="12,2,2,2"
                                  Content="{DynamicResource Lib_HighOnly}" IsChecked="{Binding HighOnly, Mode=TwoWay}"/>
                    <ToggleButton Style="{StaticResource PillToggle}" Margin="2,2"
                                  Content="{DynamicResource Lib_InvalidOnly}" IsChecked="{Binding InvalidOnly, Mode=TwoWay}"/>
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- records -->
        <ListView Grid.Row="1" ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected, Mode=TwoWay}" SelectionMode="Single"
                  Background="{DynamicResource SurfaceBrush}" BorderThickness="0" Foreground="{DynamicResource TextBrush}"
                  ItemContainerStyle="{StaticResource DetailsItemStyle}" x:Name="Rows">
            <ListView.View>
                <GridView>
                    <GridViewColumn Width="150">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="10" Height="10" Fill="{Binding CategoryBrush}" Margin="0,0,6,0"/>
                                    <TextBlock Text="{Binding CategoryName}" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Width="260">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Glyph}" FontFamily="Segoe UI Emoji" Margin="0,0,6,0"/>
                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Width="110">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding PriorityText}" Foreground="{Binding PriorityBrush}"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Width="80" DisplayMemberBinding="{Binding StatusText}"/>
                    <GridViewColumn Width="320" DisplayMemberBinding="{Binding Path}"/>
                    <GridViewColumn Width="220" DisplayMemberBinding="{Binding Note}"/>
                </GridView>
            </ListView.View>
        </ListView>

        <!-- actions -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="12,8">
            <Button Style="{StaticResource SecondaryButton}" Content="{DynamicResource Lib_OpenLocation}" Command="{Binding OpenLocationCommand}"/>
            <Button Style="{StaticResource SecondaryButton}" Margin="6,0,0,0" Content="{DynamicResource Lib_Relink}" Command="{Binding RelinkCommand}"/>
            <Button Style="{StaticResource SecondaryButton}" Margin="6,0,0,0" Content="{DynamicResource Lib_Remove}" Command="{Binding RemoveCommand}"/>
        </StackPanel>

        <Border Grid.Row="3" Background="{DynamicResource SurfaceBrush}" Padding="12,4"
                BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0">
            <TextBlock Text="{Binding Status}" Foreground="{DynamicResource SubTextBrush}" FontSize="12"/>
        </Border>
    </Grid>
</Window>
