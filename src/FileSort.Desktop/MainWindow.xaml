<Window x:Class="FileSort.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:FileSort.Desktop"
        xmlns:core="clr-namespace:FileSort.Core.Services;assembly=FileSort.Core"
        Title="{DynamicResource AppTitle}"
        Width="1280" Height="780" MinWidth="1000" MinHeight="520"
        Background="{DynamicResource BgBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI" FontSize="13">

    <Window.Resources>
        <local:ThumbnailConverter x:Key="Thumb"/>
        <BooleanToVisibilityConverter x:Key="BoolVis"/>
        <local:InverseBoolVisConverter x:Key="InverseBoolVis"/>

        <ItemsPanelTemplate x:Key="WrapPanelTpl"><WrapPanel/></ItemsPanelTemplate>
        <ItemsPanelTemplate x:Key="StackPanelTpl"><VirtualizingStackPanel/></ItemsPanelTemplate>

        <DataTemplate x:Key="IconTemplate">
            <StackPanel Width="96" ToolTip="{Binding Name}">
                <TextBlock Text="{Binding Glyph}" FontFamily="Segoe UI Emoji" FontSize="38"
                           HorizontalAlignment="Center" Opacity="{Binding Opacity}"/>
                <TextBlock Text="{Binding Name}" TextAlignment="Center" TextWrapping="Wrap"
                           TextTrimming="CharacterEllipsis" MaxHeight="36" Margin="0,4,0,0"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,2,0,0"
                            Visibility="{Binding HasCategory, Converter={StaticResource BoolVis}}">
                    <Ellipse Width="8" Height="8" Fill="{Binding CategoryBrush}" Margin="0,0,4,0"/>
                    <TextBlock Text="{Binding CategoryName}" FontSize="11" Foreground="{DynamicResource SubTextBrush}"
                               TextTrimming="CharacterEllipsis" MaxWidth="80"/>
                </StackPanel>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="ThumbTemplate">
            <StackPanel Width="148" ToolTip="{Binding Name}">
                <Grid Height="110">
                    <TextBlock Text="{Binding Glyph}" FontFamily="Segoe UI Emoji" FontSize="48"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="{Binding Opacity}"/>
                    <Image Source="{Binding ThumbnailPath, Converter={StaticResource Thumb}, IsAsync=True}"
                           Stretch="Uniform" Opacity="{Binding Opacity}"/>
                </Grid>
                <TextBlock Text="{Binding Name}" TextAlignment="Center" TextWrapping="Wrap"
                           TextTrimming="CharacterEllipsis" MaxHeight="36" Margin="0,4,0,0"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,2,0,0"
                            Visibility="{Binding HasCategory, Converter={StaticResource BoolVis}}">
                    <Ellipse Width="8" Height="8" Fill="{Binding CategoryBrush}" Margin="0,0,4,0"/>
                    <TextBlock Text="{Binding CategoryName}" FontSize="11" Foreground="{DynamicResource SubTextBrush}"
                               TextTrimming="CharacterEllipsis" MaxWidth="80"/>
                </StackPanel>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}"/>
        <KeyBinding Key="Left" Modifiers="Alt" Command="{Binding BackCommand}"/>
        <KeyBinding Key="Right" Modifiers="Alt" Command="{Binding ForwardCommand}"/>
        <KeyBinding Key="Up" Modifiers="Alt" Command="{Binding UpCommand}"/>
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Row 0: navigation, address, search, theme, language -->
        <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="8,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="280"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button Style="{StaticResource ToolButton}" Command="{Binding BackCommand}"
                            Content="{DynamicResource Glyph_Back}" ToolTip="{DynamicResource Nav_Back}"/>
                    <Button Style="{StaticResource ToolButton}" Command="{Binding ForwardCommand}"
                            Content="{DynamicResource Glyph_Forward}" ToolTip="{DynamicResource Nav_Forward}"/>
                    <Button Style="{StaticResource ToolButton}" Command="{Binding UpCommand}"
                            Content="↑" ToolTip="{DynamicResource Nav_Up}"/>
                    <Button Style="{StaticResource ToolButton}" Command="{Binding RefreshCommand}"
                            Content="↻" ToolTip="{DynamicResource Nav_Refresh}"/>
                </StackPanel>

                <TextBox x:Name="AddressBox" Grid.Column="1" Margin="8,0"
                         FlowDirection="LeftToRight"
                         Text="{Binding AddressText, UpdateSourceTrigger=PropertyChanged}">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Return" Command="{Binding GoAddressCommand}"/>
                    </TextBox.InputBindings>
                </TextBox>

                <Grid Grid.Column="2">
                    <TextBox x:Name="SearchBox" Padding="6,4,30,4"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Return" Command="{Binding SearchCommand}"/>
                            <KeyBinding Key="Escape" Command="{Binding ClearSearchCommand}"/>
                        </TextBox.InputBindings>
                    </TextBox>
                    <TextBlock Text="{DynamicResource Search_Hint}" IsHitTestVisible="False"
                               Foreground="{DynamicResource SubTextBrush}" VerticalAlignment="Center" Margin="9,0,30,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SearchText}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Button Style="{StaticResource ToolButton}" Width="26" Height="24" FontSize="12"
                            HorizontalAlignment="Right" Margin="0,0,3,0" Content="✕"
                            Command="{Binding ClearSearchCommand}" ToolTip="{DynamicResource Search_Clear}"
                            Visibility="{Binding IsSearchMode, Converter={StaticResource BoolVis}}"/>
                </Grid>

                <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="8,0,0,0">
                    <Button Style="{StaticResource ToolButton}" Content="🏷" FontFamily="Segoe UI Emoji" Click="Categories_Click"
                            ToolTip="{DynamicResource Btn_Categories}"/>
                    <Button Style="{StaticResource ToolButton}" Content="📚" FontFamily="Segoe UI Emoji" Click="Library_Click"
                            ToolTip="{DynamicResource Btn_Library}"/>
                    <Button Style="{StaticResource ToolButton}" Content="◐" Click="Theme_Click"
                            ToolTip="{DynamicResource Theme_Tip}"/>
                    <Button Style="{StaticResource ToolButton}" Width="40" FontSize="13"
                            Content="{DynamicResource Lang_Label}" Click="Lang_Click"
                            ToolTip="{DynamicResource Lang_Tip}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Row 1: breadcrumb + view/sort pills -->
        <Border Grid.Row="1" Padding="8,6" Background="{DynamicResource BgBrush}">
            <Grid>
                <ScrollViewer FlowDirection="LeftToRight"
                              HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource CrumbButton}" Content="{DynamicResource ThisPc}"
                                Command="{Binding NavigateCommand}" CommandParameter="{x:Static core:PathUtil.ThisPc}"/>
                        <ItemsControl ItemsSource="{Binding Breadcrumbs}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="›" Foreground="{DynamicResource SubTextBrush}"
                                                   VerticalAlignment="Center" Margin="2,0"/>
                                        <Button Style="{StaticResource CrumbButton}" Content="{Binding Name}"
                                                CommandParameter="{Binding FullPath}"
                                                Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

            </Grid>
        </Border>

        <!-- Row 2: view / sort / filter pills -->
        <Border Grid.Row="2" Padding="8,0,8,6" Background="{DynamicResource BgBrush}">
                <WrapPanel>
                    <ToggleButton x:Name="ViewDetails" Style="{StaticResource PillToggle}" Tag="Details"
                                  Content="{DynamicResource View_Details}" Click="ViewPill_Click"/>
                    <ToggleButton x:Name="ViewIcons" Style="{StaticResource PillToggle}" Tag="Icons"
                                  Content="{DynamicResource View_Icons}" Click="ViewPill_Click"/>
                    <ToggleButton x:Name="ViewThumbs" Style="{StaticResource PillToggle}" Tag="Thumbnails"
                                  Content="{DynamicResource View_Thumbs}" Click="ViewPill_Click"/>

                    <TextBlock Text="{DynamicResource Sort_Label}" Foreground="{DynamicResource SubTextBrush}"
                               VerticalAlignment="Center" Margin="16,0,4,0"/>
                    <ToggleButton x:Name="SortName" Style="{StaticResource PillToggle}" Tag="Name"
                                  Content="{DynamicResource Sort_Name}" Click="SortPill_Click"/>
                    <ToggleButton x:Name="SortSize" Style="{StaticResource PillToggle}" Tag="Size"
                                  Content="{DynamicResource Sort_Size}" Click="SortPill_Click"/>
                    <ToggleButton x:Name="SortModified" Style="{StaticResource PillToggle}" Tag="Modified"
                                  Content="{DynamicResource Sort_Modified}" Click="SortPill_Click"/>
                    <ToggleButton x:Name="SortCreated" Style="{StaticResource PillToggle}" Tag="Created"
                                  Content="{DynamicResource Sort_Created}" Click="SortPill_Click"/>
                    <ToggleButton x:Name="SortType" Style="{StaticResource PillToggle}" Tag="Type"
                                  Content="{DynamicResource Sort_Type}" Click="SortPill_Click"/>
                    <TextBlock Text="{Binding SortDirectionGlyph}" Foreground="{DynamicResource SubTextBrush}"
                               VerticalAlignment="Center" Margin="4,0"/>

                    <ToggleButton Style="{StaticResource PillToggle}" Margin="12,0,0,0"
                                  Content="{DynamicResource ShowHidden}"
                                  IsChecked="{Binding ShowHidden, Mode=TwoWay}"/>
                    <ToggleButton x:Name="FilterAll" Style="{StaticResource PillToggle}" Tag="All" Margin="12,0,2,0"
                                  Content="{DynamicResource Filter_All}" Click="FilterPill_Click"/>
                    <ToggleButton x:Name="FilterClassified" Style="{StaticResource PillToggle}" Tag="Classified"
                                  Content="{DynamicResource Filter_Classified}" Click="FilterPill_Click"/>
                    <ToggleButton x:Name="FilterUnclassified" Style="{StaticResource PillToggle}" Tag="Unclassified"
                                  Content="{DynamicResource Filter_Unclassified}" Click="FilterPill_Click"/>
                </WrapPanel>
        </Border>

        <!-- Row 3: error banner -->
        <Border Grid.Row="3" Background="{DynamicResource ErrorBgBrush}" Padding="12,6"
                Visibility="{Binding HasError, Converter={StaticResource BoolVis}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding ErrorText}" Foreground="{DynamicResource ErrorTextBrush}"
                           TextWrapping="Wrap" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Style="{StaticResource ToolButton}" Width="26" Height="24" FontSize="12"
                        Content="✕" Command="{Binding DismissErrorCommand}" ToolTip="{DynamicResource Err_Dismiss}"/>
            </Grid>
        </Border>

        <!-- Row 4: sidebar | files | details -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230" MinWidth="160"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="320" MinWidth="240"/>
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,1,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8">
                        <Button Style="{StaticResource SideButton}" Command="{Binding NavigateCommand}"
                                CommandParameter="{x:Static core:PathUtil.ThisPc}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🖥️" FontFamily="Segoe UI Emoji" Margin="0,0,8,0"/>
                                <TextBlock Text="{DynamicResource ThisPc}" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>

                        <TextBlock Text="{DynamicResource QuickAccess}" Foreground="{DynamicResource SubTextBrush}"
                                   FontSize="11" Margin="10,14,0,4"/>
                        <ItemsControl ItemsSource="{Binding QuickAccess}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource SideButton}" CommandParameter="{Binding Path}"
                                            Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Glyph}" FontFamily="Segoe UI Emoji" Margin="0,0,8,0"/>
                                            <TextBlock Text="{Binding Name}"/>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="{DynamicResource Drives}" Foreground="{DynamicResource SubTextBrush}"
                                   FontSize="11" Margin="10,14,0,4"/>
                        <ItemsControl ItemsSource="{Binding Drives}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource SideButton}" CommandParameter="{Binding RootPath}"
                                            Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Glyph}" FontFamily="Segoe UI Emoji" Margin="0,0,8,0"/>
                                                <TextBlock Text="{Binding Display}" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                            <ProgressBar Value="{Binding UsedPercent, Mode=OneWay}" Maximum="100" Height="4" Margin="0,5,0,2"
                                                         Foreground="{DynamicResource AccentBrush}"
                                                         Background="{DynamicResource LineBrush}" BorderThickness="0"/>
                                            <TextBlock Text="{Binding FreeText}" FontSize="11"
                                                       Foreground="{DynamicResource SubTextBrush}"/>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Border>
            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="Transparent"/>

            <!-- Files -->
            <Grid Grid.Column="2" Background="{DynamicResource SurfaceBrush}">
                <ListView x:Name="FileList" ItemsSource="{Binding Entries}" SelectionMode="Extended"
                          Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextBrush}"
                          SelectionChanged="FileList_SelectionChanged"
                          MouseDoubleClick="FileList_MouseDoubleClick" KeyDown="FileList_KeyDown">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Width="280">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Glyph}" FontFamily="Segoe UI Emoji" FontSize="16"
                                                       Width="24" Margin="0,0,6,0" Opacity="{Binding Opacity}"/>
                                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" Opacity="{Binding Opacity}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Width="150" DisplayMemberBinding="{Binding ModifiedText}"/>
                            <GridViewColumn Width="140" DisplayMemberBinding="{Binding TypeText}"/>
                            <GridViewColumn Width="90" DisplayMemberBinding="{Binding SizeText}"/>
                            <GridViewColumn Width="140">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Visibility="{Binding HasCategory, Converter={StaticResource BoolVis}}">
                                            <Ellipse Width="10" Height="10" Fill="{Binding CategoryBrush}" Margin="0,0,6,0"/>
                                            <TextBlock Text="{Binding CategoryName}" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Width="110">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding PriorityText}" Foreground="{Binding PriorityBrush}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>

                <ProgressBar IsIndeterminate="True" Height="3" VerticalAlignment="Top"
                             Foreground="{DynamicResource AccentBrush}" Background="Transparent" BorderThickness="0"
                             Visibility="{Binding ShowProgress, Converter={StaticResource BoolVis}}"/>
                <TextBlock Text="{Binding EmptyText}" Foreground="{DynamicResource SubTextBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"
                           Visibility="{Binding IsEmpty, Converter={StaticResource BoolVis}}"/>
            </Grid>
            <GridSplitter Grid.Column="3" HorizontalAlignment="Stretch" Background="Transparent"/>

            <!-- Details panel -->
            <Border Grid.Column="4" Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource LineBrush}" BorderThickness="1,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="14">
                        <TextBlock Text="{DynamicResource Details_Title}" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,10"/>

                        <TextBlock Text="{DynamicResource Details_None}" TextWrapping="Wrap"
                                   Foreground="{DynamicResource SubTextBrush}"
                                   Visibility="{Binding NoSelection, Converter={StaticResource BoolVis}}"/>

                        <StackPanel Visibility="{Binding HasSingleSelection, Converter={StaticResource BoolVis}}">
                            <Grid Height="130" Margin="0,0,0,10">
                                <TextBlock Text="{Binding SelectedEntry.Glyph}" FontFamily="Segoe UI Emoji" FontSize="56"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Image Source="{Binding SelectedEntry.ThumbnailPath, Converter={StaticResource Thumb}, IsAsync=True}"
                                       Stretch="Uniform"/>
                            </Grid>
                            <TextBlock Text="{Binding SelectedEntry.Name}" FontWeight="SemiBold" FontSize="14"
                                       TextWrapping="Wrap" Margin="0,0,0,8"/>
                            <ItemsControl ItemsSource="{Binding Properties}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,5">
                                            <TextBlock Text="{Binding Label}" FontSize="11"
                                                       Foreground="{DynamicResource SubTextBrush}"/>
                                            <TextBlock Text="{Binding Value}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Style="{StaticResource AccentButton}" Margin="0,14,0,0"
                                    Content="{DynamicResource Details_Open}"
                                    Command="{Binding OpenCommand}" CommandParameter="{Binding SelectedEntry}"/>
                        </StackPanel>

                        <StackPanel Visibility="{Binding HasMultiSelection, Converter={StaticResource BoolVis}}">
                            <TextBlock Text="{Binding MultiSelectionText}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding MultiSizeText}" Foreground="{DynamicResource SubTextBrush}"
                                       TextWrapping="Wrap" Margin="0,6,0,0"/>
                        </StackPanel>

                        <!-- Manual classification -->
                        <StackPanel Margin="0,18,0,0" Visibility="{Binding IsClassifiable, Converter={StaticResource BoolVis}}">
                            <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Margin="0,0,0,12"/>
                            <TextBlock Text="{DynamicResource Cls_Title}" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,8"/>

                            <TextBlock Text="{DynamicResource Cls_Category}" FontSize="11" Foreground="{DynamicResource SubTextBrush}"/>
                            <ItemsControl ItemsSource="{Binding Categories}" Margin="0,4,0,8">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <ToggleButton Style="{StaticResource PillToggle}" Margin="2,3"
                                                      IsChecked="{Binding IsSelected, Mode=OneWay}" CommandParameter="{Binding}"
                                                      Command="{Binding DataContext.SelectCategoryCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="10" Height="10" Fill="{Binding Brush}" Margin="0,0,6,0"/>
                                                <TextBlock Text="{Binding Name}"/>
                                            </StackPanel>
                                        </ToggleButton>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{DynamicResource Cls_NoCategories}" TextWrapping="Wrap" FontSize="11"
                                       Foreground="{DynamicResource SubTextBrush}"
                                       Visibility="{Binding HasCategories, Converter={StaticResource InverseBoolVis}}"/>

                            <TextBlock Text="{DynamicResource Cls_Priority}" FontSize="11" Foreground="{DynamicResource SubTextBrush}"/>
                            <ItemsControl ItemsSource="{Binding Priorities}" Margin="0,4,0,8">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <ToggleButton Style="{StaticResource PillToggle}" Margin="2,3"
                                                      IsChecked="{Binding IsSelected, Mode=OneWay}" CommandParameter="{Binding}"
                                                      Command="{Binding DataContext.SelectPriorityCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                                            <StackPanel Orientation="Horizontal">
                                                <Rectangle Width="10" Height="10" RadiusX="2" RadiusY="2" Fill="{Binding Brush}" Margin="0,0,6,0"/>
                                                <TextBlock Text="{Binding Name}"/>
                                            </StackPanel>
                                        </ToggleButton>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="{DynamicResource Cls_Note}" FontSize="11" Foreground="{DynamicResource SubTextBrush}"/>
                            <TextBox Text="{Binding NoteText, UpdateSourceTrigger=PropertyChanged}" Height="64" Margin="0,4,0,8"
                                     AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MaxLength="1000"
                                     VerticalContentAlignment="Top"/>

                            <ToggleButton Style="{StaticResource PillToggle}" HorizontalAlignment="Left" Margin="0,0,0,8"
                                          Content="{DynamicResource Cls_IncludeContents}" IsChecked="{Binding IncludeContents, Mode=TwoWay}"
                                          Visibility="{Binding HasFolderSelected, Converter={StaticResource BoolVis}}"/>

                            <WrapPanel>
                                <Button Style="{StaticResource AccentButton}" Margin="0,0,8,6"
                                        Content="{DynamicResource Cls_Apply}" Command="{Binding ApplyClassificationCommand}"/>
                                <Button Style="{StaticResource SecondaryButton}" Margin="0,0,0,6"
                                        Content="{DynamicResource Cls_Clear}" Command="{Binding ClearClassificationCommand}"/>
                            </WrapPanel>
                            <TextBlock Text="{Binding PanelMessage}" TextWrapping="Wrap" Foreground="{DynamicResource SubTextBrush}"/>
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Row 5: status bar -->
        <Border Grid.Row="5" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="12,4">
            <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource SubTextBrush}" FontSize="12"/>
        </Border>
    </Grid>
</Window>
